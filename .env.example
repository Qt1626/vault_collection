# Copier ce fichier en .env (jamais commité) puis adapter les valeurs.
#   cp .env.example .env

# --- Base de données ---
DB_NAME=pinvault
DB_USER=pinvault
DB_PASSWORD=change-moi

# --- Sécurité ---
# Au moins 32 caractères. Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=remplace-moi-par-un-secret-long-et-aleatoire-0123456789

# --- Production uniquement (docker-compose.prod.yml) ---
DOCKERHUB_USERNAME=ton-pseudo-docker-hub
TAG=latest
PUBLIC_URL=http://localhost:3000
