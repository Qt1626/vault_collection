# Fichier .env du SERVEUR (à copier à la racine du projet sur la VM : cp deploy/.env.server.example .env)
# Ne jamais le committer.

# Adresse du site. Avec le nom DNS gratuit d'Azure : <ton-label>.francecentral.cloudapp.azure.com
DOMAIN=pinvault-quentin.francecentral.cloudapp.azure.com

DB_NAME=pinvault
DB_USER=pinvault
# Générer avec : openssl rand -base64 24
DB_PASSWORD=A_REMPLACER

# Générer avec : openssl rand -base64 48
JWT_SECRET=A_REMPLACER
